{
  "name": "overlay-image-gallery",
  "description": "Overlay Image Gallery is a lightweight, animated React gallery: mosaic grids, a lightbox with zoom, swipe, keyboard navigation, fullscreen and more.",
  "homepage": "https://b-owl.github.io/overlay-image-gallery",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "overlay-image-gallery",
    "image-gallery",
    "lightbox",
    "react",
    "nextjs",
    "typescript",
    "drag",
    "react-component",
    "zoom",
    "carousel",
    "slide-show",
    "slider",
    "swipe",
    "touch",
    "gallery",
    "responsive",
    "mobile-friendly",
    "accessible"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc -p tsconfig.types.json && rollup -c",
    "build:demo": "vite build",
    "prepare": "npm run build:lib",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d demo-dist",
    "lint": "eslint . --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b-owl/overlay-image-gallery.git"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
